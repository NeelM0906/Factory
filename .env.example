# Local state directory. SQLite, WAL, and future workspace metadata live here.
AUTOSTACK_DATA_DIR=./autostack-data

# Generate a private value with: openssl rand -hex 32
# This placeholder is intentionally not a usable credential.
AUTOSTACK_LOCAL_API_TOKEN=AUTOSTACK_EXAMPLE_TOKEN_DO_NOT_USE

# The foundation binds only to loopback by default.
AUTOSTACK_HOST=127.0.0.1
AUTOSTACK_PORT=4318

# Base URL used by the CLI. The web app uses Vite's local /v1 proxy in development.
AUTOSTACK_URL=http://127.0.0.1:4318

# Development escape hatch. Keep false unless the machine and network are trusted.
AUTOSTACK_ALLOW_NON_LOOPBACK=false
