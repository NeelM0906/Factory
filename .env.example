# Control-plane browser/CLI development only. Desktop mode ignores this file.
# Local state directory. SQLite, WAL, and workspace metadata live here.
AUTOSTACK_DATA_DIR=./autostack-data

# Control-plane browser/CLI development only. Generate with: openssl rand -hex 32
# This placeholder is intentionally not a usable credential.
AUTOSTACK_LOCAL_API_TOKEN=AUTOSTACK_EXAMPLE_TOKEN_DO_NOT_USE

# Control-plane development only. The desktop supervises ephemeral loopback ports.
AUTOSTACK_HOST=127.0.0.1
AUTOSTACK_PORT=4318

# Browser/CLI development only. Desktop never receives its origin from this file.
AUTOSTACK_URL=http://127.0.0.1:4318

# Control-plane development escape hatch. Desktop mode never enables it.
AUTOSTACK_ALLOW_NON_LOOPBACK=false
