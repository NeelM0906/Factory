{
  "name": "@autostack/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsup --config tsup.guardian.config.ts && tsup --config tsup.utility.config.ts && node scripts/build-runtime-manifest.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "runtime:manifest": "node scripts/build-runtime-manifest.mjs"
  },
  "dependencies": {
    "@autostack/client-app": "workspace:*",
    "@autostack/control-plane": "workspace:*",
    "@autostack/contracts": "workspace:*",
    "@autostack/host-daemon": "workspace:*",
    "@autostack/runner-local": "workspace:*",
    "@autostack/ui": "workspace:*",
    "electron": "43.4.0",
    "node-pty": "1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@autostack/db": "workspace:*",
    "@autostack/domain": "workspace:*",
    "@axe-core/playwright": "4.12.1",
    "@electron/rebuild": "4.0.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron-vite": "5.0.0",
    "jsdom": "^26.1.0",
    "playwright": "1.62.1",
    "vite": "^7.1.5"
  }
}
