{
  "scenario": "conformance-minimal-completes",
  "frames": [
    { "kind": "awaitStdin", "match": { "method": "initialize" } },
    {
      "kind": "emit",
      "value": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": 1,
          "agentInfo": { "name": "conformance-acp-agent-minimal", "version": "1.0.0" },
          "agentCapabilities": {
            "loadSession": false,
            "promptCapabilities": { "image": false, "audio": false, "embeddedContext": false },
            "mcpCapabilities": { "http": false, "sse": false }
          }
        }
      }
    },
    { "kind": "awaitStdin", "match": { "method": "session/new" } },
    {
      "kind": "emit",
      "value": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "sessionId": "sess_conf_minimal"
        }
      }
    },
    { "kind": "awaitStdin", "match": { "method": "session/prompt" } },
    {
      "kind": "emit",
      "value": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_conf_minimal",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": { "type": "text", "text": "Done with the task." }
          }
        }
      }
    },
    {
      "kind": "emit",
      "value": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": { "stopReason": "end_turn" }
      }
    },
    { "kind": "exit", "code": 0, "signal": null }
  ]
}
