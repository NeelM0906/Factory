{
  "scenario": "conformance-full-completes-resume",
  "frames": [
    { "kind": "awaitStdin", "match": { "method": "initialize" } },
    {
      "kind": "emit",
      "value": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": 1,
          "agentInfo": { "name": "conformance-acp-agent", "version": "1.0.0" },
          "agentCapabilities": {
            "loadSession": true,
            "promptCapabilities": { "image": false, "audio": false, "embeddedContext": false },
            "mcpCapabilities": { "http": false, "sse": false },
            "sessionCapabilities": { "list": {}, "close": {} },
            "auth": { "logout": {} }
          }
        }
      }
    },
    { "kind": "awaitStdin", "match": { "method": "session/load" } },
    {
      "kind": "emit",
      "value": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "sessionId": "sess_conf_full_completes"
        }
      }
    },
    { "kind": "awaitStdin", "match": { "method": "session/prompt" } },
    {
      "kind": "emit",
      "value": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_conf_full_completes",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": { "type": "text", "text": "Resuming the session." }
          }
        }
      }
    },
    {
      "kind": "emit",
      "value": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": { "stopReason": "end_turn" }
      }
    },
    { "kind": "exit", "code": 0, "signal": null }
  ]
}
